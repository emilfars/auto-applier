{
  "name": "@auto-applier/extension",
  "version": "0.1.0",
  "description": "Chrome MV3 extension that autofills job application forms using the shared @auto-applier/fill-mappings engine. Autofill only — the human always clicks apply (Prime Directive).",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node build.mjs"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "happy-dom": "^15.11.7",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.21.5": true
  }
}
